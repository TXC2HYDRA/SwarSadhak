API_HOST=0.0.0.0
API_PORT=8020
DATABASE_URL=sqlite:///./data/swar_sadhak.db
AUTH_MODE=local
AUTH_SECRET=replace-for-local-development
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=
AI_TIMEOUT_MS=8000
# Assignment files (audio, video, PDF, images). Default: local disk (apps/data/storage) served by this API
# with the same presigned URLs as R2. Fill in the four R2 values to switch to Cloudflare R2 automatically.
# Check either with: python3 apps/api/run.py check-storage (local: while the API runs)
# STORAGE_BACKEND=local
# STORAGE_DIR=data/storage
# API_PUBLIC_URL=http://localhost:8020
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional Google Meet links: teachers connect their Google account (docs/google-meet-integration.md,
# "Setting up Google"). Leave empty to keep manual links only. GOOGLE_REDIRECT_URI must be <this API>/api/google/callback.
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEB_APP_URL is where teachers land after Google (default: the first CORS origin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
# WEB_APP_URL=http://localhost:5173
