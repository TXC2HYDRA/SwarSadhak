# Copy this file to .env for local configuration.
NODE_ENV=development
PORT=3000
# Optional API: Vite reads VITE_* settings from apps/web, so put
# VITE_API_URL=http://localhost:8020 in apps/web/.env.local (not here). Leave it unset for the offline flow.
# Phase 5 AI is optional and disabled by default. Provider secrets are server-side only.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=
AI_TIMEOUT_MS=8000
# Docker Compose (docker compose up --build). Set AUTH_SECRET to a long random value for real use.
AUTH_SECRET=
# API_PORT=8020
# WEB_PORT=4173
# PUBLIC_API_URL=http://localhost:8020
# PUBLIC_WEB_URL=http://localhost:4173
# Optional Google Meet links (Docker Compose passes these to the API). See docs/google-meet-integration.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8020/api/google/callback
# TOKEN_ENCRYPTION_KEY=
