# Copy this file to .env for local configuration.
NODE_ENV=development
PORT=3000
# Optional API. Leave empty for the fully local/offline flow.
VITE_API_URL=
# Phase 5 AI is optional and disabled by default. Provider secrets are server-side only.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=
AI_TIMEOUT_MS=8000
